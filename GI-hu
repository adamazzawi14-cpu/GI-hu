local function txt(key)
	local pack = texts[currentLang] or texts.ar
	return pack[key] or texts.ar[key] or key
end

local function paintGreen(btn, stroke, active)
	if not btn then return end
	if active then
		btn.BackgroundColor3 = Color3.fromRGB(30, 185, 95)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		if stroke then
			stroke.Color = Color3.fromRGB(165, 255, 205)
			stroke.Thickness = 1.8
			stroke.Transparency = 0
		end
	else
		btn.BackgroundColor3 = Color3.fromRGB(25, 34, 54)
		btn.TextColor3 = Color3.fromRGB(230, 240, 255)
		if stroke then
			stroke.Color = Color3.fromRGB(125, 215, 255)
			stroke.Thickness = 1.1
			stroke.Transparency = 0.4
		end
	end
end

local function bindClick(btn, fn)
	if not btn then return end
	local lastFire = 0
	local function trigger()
		if not isCurrentSession() then return end
		local t = os.clock()
		if t - lastFire < 0.14 then return end
		lastFire = t
		pcall(fn)
	end
	btn.MouseButton1Click:Connect(trigger)
	btn.Activated:Connect(trigger)
end

local function makeDraggable(guiObj, onTap)
	guiObj.Active = true
	local dragging = false
	local dragStart = Vector2.zero
	local startPos = guiObj.Position
	local moved = false

	guiObj.InputBegan:Connect(function(input)
		if not isCurrentSession() then return end
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			moved = false
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = guiObj.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not isCurrentSession() then return end
		if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			if delta.Magnitude > 14 then
				moved = true
			end
			guiObj.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			if dragging then
				dragging = false
				if not moved and onTap then
					pcall(onTap)
				end
			end
		end
	end)
end

