local function getTimeBombStats()
	local kills, wins = 0, 0
	pcall(function()
		local function scanContainer(container)
			if not container then return end
			for _, child in ipairs(container:GetDescendants()) do
				if child:IsA("IntValue") or child:IsA("NumberValue") then
					local n = string.lower(child.Name)
					if n == "kills" or n == "ko" or n == "kos" or string.find(n, "kill", 1, true) then
						kills = math.max(kills, tonumber(child.Value) or 0)
					elseif n == "wins" or n == "win" or string.find(n, "win", 1, true) then
						wins = math.max(wins, tonumber(child.Value) or 0)
					end
				end
			end
		end
		scanContainer(player:FindFirstChild("leaderstats"))
		scanContainer(player)
	end)
	return math.floor(kills), math.floor(wins)
end

