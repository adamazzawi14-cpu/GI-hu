local function clearEffects()
	pcall(function()
		local oldHl = gui:FindFirstChild("GI_Hub_Highlight")
		if oldHl then oldHl:Destroy() end
	end)
	local char = player.Character
	if char then
		for _, obj in ipairs(char:GetDescendants()) do
			if obj.Name == "GI_Hub_Highlight" or obj.Name == "GI_Hub_Trail" or obj.Name == "GI_Hub_A0" or obj.Name == "GI_Hub_A1" then
				pcall(function() obj:Destroy() end)
			end
		end
	end
end

local function applyEffects()
	clearEffects()
	local char = player.Character
	if not char then return end
	if auraOn then
		pcall(function()
			local hl = Instance.new("Highlight")
			hl.Name = "GI_Hub_Highlight"
			hl.Adornee = char
			hl.FillColor = Color3.fromRGB(30, 215, 115)
			hl.OutlineColor = Color3.fromRGB(185, 255, 215)
			hl.FillTransparency = 0.5
			hl.OutlineTransparency = 0.05
			hl.Parent = gui
		end)
	end
	if trailOn then
		pcall(function()
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local a0 = Instance.new("Attachment")
				a0.Name = "GI_Hub_A0"
				a0.Position = Vector3.new(0, 1.2, 0)
				a0.Parent = hrp
				local a1 = Instance.new("Attachment")
				a1.Name = "GI_Hub_A1"
				a1.Position = Vector3.new(0, -1.2, 0)
				a1.Parent = hrp
				local tr = Instance.new("Trail")
				tr.Name = "GI_Hub_Trail"
				tr.Attachment0 = a0
				tr.Attachment1 = a1
				tr.Lifetime = 0.35
				tr.MinLength = 0.05
				tr.Color = ColorSequence.new(Color3.fromRGB(30, 215, 115), Color3.fromRGB(120, 220, 255))
				tr.Transparency = NumberSequence.new(0.1, 1)
				tr.Parent = hrp
			end
		end)
	end
end

