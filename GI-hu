local function updateGap(v)
	gapValue = math.clamp(math.floor(v * 10 + 0.5) / 10, 1.5, 10.0)
	gapFill.Size = UDim2.new((gapValue - 1.5) / 8.5, 0, 1, 0)
	refreshLabels()
