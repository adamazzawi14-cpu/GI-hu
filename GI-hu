local function setPovAlpha(a, adjustToggle)
	a = math.clamp(a, 0, 1)
	povWireFill.Size = UDim2.new(a, 0, 1, 0)
	povKnob.Position = UDim2.new(a, 0, 0.5, 0)
	povValue = math.floor(minFov + ((maxFov - minFov) * a) + 0.5)
	povSliderLabel.Text = string.format(txt("povSliderFmt"), povValue)

	if adjustToggle then
		povEnabled = (povValue > minFov)
		paintGreen(btnPov, povStroke, povEnabled)
	end
end

local function setUiScaleAlpha(a)
	a = math.clamp(a, 0, 1)
	scaleWireFill.Size = UDim2.new(a, 0, 1, 0)
	scaleKnob.Position = UDim2.new(a, 0, 0.5, 0)
	local rawScale = minUiScale + ((maxUiScale - minUiScale) * a)
	uiScaleValue = math.floor(rawScale * 100 + 0.5) / 100
	scaleLbl.Text = string.format(txt("uiScaleFmt"), uiScaleValue)
end

